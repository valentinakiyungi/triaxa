# Copy to .env and adjust. Every value has a sensible default.

# --- LLM backend --------------------------------------------------------------
# "openai" = any OpenAI-compatible server (LM Studio, Ollama, vLLM, llama.cpp, OpenAI)
# "mock"   = built-in keyword classifier, no model needed (demos / CI)
LLM_PROVIDER=openai

# LM Studio:  http://127.0.0.1:1234/v1
# Ollama:     http://127.0.0.1:11434/v1
# OpenAI:     https://api.openai.com/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=not-needed-locally

# "auto" picks the first model the server reports as loaded.
# For OpenAI or Ollama, set the exact name, e.g. gpt-4o-mini or llama3.1
LLM_MODEL=auto
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_VALIDATION_RETRIES=2

# --- Pipeline ------------------------------------------------------------------
WORKER_CONCURRENCY=2
MAX_JOB_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
MAX_BATCH_SIZE=100
MAX_TEXT_LENGTH=20000

# --- Server ----------------------------------------------------------------------
DATABASE_PATH=data/pipeline.db
# Set to require an X-API-Key header on every API call (the dashboard will ask for it)
# API_KEY=change-me
CORS_ORIGINS=*
LOG_LEVEL=INFO
